//@version=5
strategy("Donchian Breakout + Volume Confirmation (Crypto Intraday)",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.075,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=true)

// =====================================================================================
// INPUTS
// =====================================================================================

grp_range   = "Range / Breakout Settings"
grp_trend   = "Trend Filter"
grp_vol     = "Volume Confirmation"
grp_risk    = "Risk Management"
grp_lev     = "Leverage / Liquidation Safety"
grp_vis     = "Visuals"

donchianLen = input.int(55, "Donchian Channel Length", minval=5, maxval=200, group=grp_range,
     tooltip="Number of bars used to calculate the breakout high/low. Longer = fewer, higher-conviction signals.")

useTrendFilter = input.bool(true, "Use Trend Filter", group=grp_trend,
     tooltip="When enabled, longs only trigger above the trend EMA and shorts only trigger below it. This filters out breakouts that fire against the prevailing trend.")
trendEmaLen = input.int(150, "Trend EMA Length", minval=20, maxval=400, group=grp_trend,
     tooltip="Longer = slower, stricter trend definition. Shorter = more responsive but more whipsaw-prone.")

volMALen    = input.int(20, "Volume MA Length", minval=5, maxval=100, group=grp_vol)
volMultiplier = input.float(1.5, "Volume Multiplier (x average)", minval=1.0, maxval=5.0, step=0.1, group=grp_vol,
     tooltip="Volume must exceed this multiple of its moving average to confirm a breakout.")

atrLen      = input.int(14, "ATR Length", minval=5, maxval=50, group=grp_risk)
atrMult     = input.float(2.0, "ATR Stop Multiplier", minval=0.5, maxval=10.0, step=0.1, group=grp_risk,
     tooltip="Stop-loss distance = ATR x this multiplier.")
rrRatio     = input.float(2.0, "Take Profit R:R Ratio", minval=0.5, maxval=10.0, step=0.1, group=grp_risk,
     tooltip="Take-profit distance = stop-loss distance x this ratio.")
riskPercent = input.float(2.0, "Risk Per Trade (% of Equity)", minval=0.1, maxval=25.0, step=0.1, group=grp_risk,
     tooltip="Percent of current equity risked per trade. Position size is derived from this and the ATR stop distance.")
minProfitForOppExitMult = input.float(1.0, "Min. Favorable Move Before Opposite-Signal Exit (x ATR)", minval=0.0, maxval=5.0, step=0.1, group=grp_risk,
     tooltip="Opposite-signal exits are ignored until the trade has moved this many ATR multiples in its favor. The ATR stop-loss still applies immediately regardless of this setting. Set to 0 to disable (opposite-signal can close a trade at any time, as before).")

useLeverage = input.bool(false, "Trading on Leveraged Futures (not spot)", group=grp_lev,
     tooltip="Turn ON if this runs on a leveraged futures/margin account. This activates liquidation-aware position sizing, which caps position size so it can never exceed what your margin and exchange's maintenance-margin rules can actually support. Leave OFF for spot/no-leverage accounts.")
leverageAmt = input.float(10.0, "Leverage (x)", minval=1.0, maxval=125.0, step=1.0, group=grp_lev,
     tooltip="Your account's leverage multiple, e.g. 10 for 10x. Set this to match what you actually use on your exchange.")
maintMarginPct = input.float(0.5, "Maintenance Margin Rate (%)", minval=0.1, maxval=10.0, step=0.05, group=grp_lev,
     tooltip="Your exchange's maintenance margin rate for the position size you trade, as a percent of position value. This varies by exchange AND by position size (larger positions usually require a higher rate). Check your exchange's futures margin-tier table for the correct number at your typical position size -- do not assume this default is right for your platform.")
liqSafetyBufferMult = input.float(1.5, "Liquidation Safety Buffer (x stop distance)", minval=1.1, maxval=5.0, step=0.1, group=grp_lev,
     tooltip="The distance from entry to your exchange's estimated liquidation price must be at least this many multiples of your ATR stop distance. If it isn't, the trade is skipped entirely -- taking it would mean the exchange could liquidate you before your own stop-loss has a chance to fire. Higher = safer but fewer/smaller trades allowed at high leverage.")

allowLong   = input.bool(true, "Allow Long Trades", group=grp_range)
allowShort  = input.bool(true, "Allow Short Trades", group=grp_range)

showTable   = input.bool(true, "Show Performance Table", group=grp_vis)
showMarkers = input.bool(true, "Show Entry/Exit/SL/TP Markers", group=grp_vis)

// =====================================================================================
// CORE CALCULATIONS
// =====================================================================================

donchianHigh = ta.highest(high, donchianLen)
donchianLow  = ta.lowest(low, donchianLen)

// Use the prior bar's channel so the breakout is measured against the range
// that existed BEFORE the current bar, avoiding lookahead/repainting issues.
priorHigh = donchianHigh[1]
priorLow  = donchianLow[1]

volMA = ta.sma(volume, volMALen)
volConfirmed = volume > (volMA * volMultiplier)

atrVal = ta.atr(atrLen)

trendEma = ta.ema(close, trendEmaLen)
trendAllowsLong  = not useTrendFilter or close > trendEma
trendAllowsShort = not useTrendFilter or close < trendEma

longBreakout  = ta.crossover(close, priorHigh)
shortBreakout = ta.crossunder(close, priorLow)

longEntrySignal  = longBreakout  and volConfirmed and allowLong  and trendAllowsLong
shortEntrySignal = shortBreakout and volConfirmed and allowShort and trendAllowsShort

// Opposite-side channel break used as the discretionary exit trigger
longExitSignal  = ta.crossunder(close, priorLow)
shortExitSignal = ta.crossover(close, priorHigh)

// =====================================================================================
// POSITION SIZING
// =====================================================================================
// SPOT MODE (useLeverage = false): unchanged from before --
//   Contracts = (Equity x Risk%) / (Stop distance in price)
//
// LEVERAGED MODE (useLeverage = true): the risk-based formula above can produce a
// notional position size many multiples of account equity when ATR is small relative
// to price. On a leveraged account this is dangerous in a specific way: the exchange's
// liquidation price can sit CLOSER to entry than your own ATR stop-loss, meaning the
// exchange closes the position (at a full-margin loss) before your stop ever fires.
//
// The fix is not just "reduce size" -- it's a hard gate: calculate the liquidation
// distance implied by the chosen leverage and maintenance margin rate, and REFUSE the
// trade entirely if the ATR stop distance doesn't fit safely inside it (with a buffer
// margin, since slippage/wicks can punch through a stop that's only barely inside).

longStopDistance  = atrVal * atrMult
shortStopDistance = atrVal * atrMult

// Standard isolated-margin liquidation-distance approximation, expressed as a fraction
// of entry price. This ignores funding-fee accrual (a reasonable simplification for a
// stop-safety check, though it means the true liquidation distance is very slightly
// tighter than this on a position held across multiple funding intervals).
liqDistanceFraction = useLeverage ? math.max((1.0 / leverageAmt) - (maintMarginPct / 100), 0.0) : na

// Convert to a price distance using the current close as an approximation of entry price
liqDistancePrice = useLeverage ? close * liqDistanceFraction : na

// A trade is only allowed if the liquidation distance is at least the safety-buffer
// multiple of the ATR stop distance -- i.e. the exchange would need price to move much
// further against the position than the stop-loss does before liquidation could occur.
//
// IMPORTANT: this checks na(liqDistancePrice) explicitly rather than relying on
// "not useLeverage or (comparison)" -- Pine's na-propagation rule means ANY comparison
// involving na returns na (not false), and a na logical expression takes the FALSE
// branch of a conditional. Relying on operator short-circuiting to skip the comparison
// would be incorrect here: this script targets v5, which uses strict (non-short-circuit)
// evaluation, so the right side of "or" is evaluated regardless of the left side.
longLiqSafe  = na(liqDistancePrice) ? true : (liqDistancePrice >= longStopDistance  * liqSafetyBufferMult)
shortLiqSafe = na(liqDistancePrice) ? true : (liqDistancePrice >= shortStopDistance * liqSafetyBufferMult)

longRiskCapital  = strategy.equity * (riskPercent / 100)
shortRiskCapital = strategy.equity * (riskPercent / 100)

// Risk-based quantity (same formula as before)
longQtyRiskBased  = longStopDistance  > 0 ? longRiskCapital  / longStopDistance  : 0.0
shortQtyRiskBased = shortStopDistance > 0 ? shortRiskCapital / shortStopDistance : 0.0

// In leveraged mode, additionally cap quantity so notional position value never exceeds
// equity x leverage -- this is the hard ceiling that prevents a Trade #1-style scenario
// ($34K position on $10K equity) from ever happening again, independent of the ATR math.
longQtyLeverageCap  = useLeverage and close > 0 ? (strategy.equity * leverageAmt) / close : 1e15
shortQtyLeverageCap = useLeverage and close > 0 ? (strategy.equity * leverageAmt) / close : 1e15

longQty  = math.min(longQtyRiskBased,  longQtyLeverageCap)
shortQty = math.min(shortQtyRiskBased, shortQtyLeverageCap)

// =====================================================================================
// ENTRIES
// =====================================================================================

var int longBlockedByLiqSafety  = 0
var int shortBlockedByLiqSafety = 0

longEntryLiqBlocked  = longEntrySignal  and not longLiqSafe
shortEntryLiqBlocked = shortEntrySignal and not shortLiqSafe

if longEntryLiqBlocked and strategy.position_size == 0
    longBlockedByLiqSafety := longBlockedByLiqSafety + 1

if shortEntryLiqBlocked and strategy.position_size == 0
    shortBlockedByLiqSafety := shortBlockedByLiqSafety + 1

if longEntrySignal and longLiqSafe and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=longQty)

if shortEntrySignal and shortLiqSafe and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=shortQty)

// =====================================================================================
// EXITS
// =====================================================================================
// Each position exits on whichever comes first: ATR stop, R:R take-profit,
// or an opposite-side Donchian break.

var float longStopPrice  = na
var float longTPPrice    = na
var float shortStopPrice = na
var float shortTPPrice   = na

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    longStopPrice := close - longStopDistance
    longTPPrice   := close + (longStopDistance * rrRatio)

if strategy.position_size < 0 and strategy.position_size[1] >= 0
    shortStopPrice := close + shortStopDistance
    shortTPPrice   := close - (shortStopDistance * rrRatio)

if strategy.position_size <= 0
    longStopPrice := na
    longTPPrice   := na

if strategy.position_size >= 0
    shortStopPrice := na
    shortTPPrice   := na

// Minimum favorable movement required before opposite-signal is allowed to close a trade.
// The ATR stop-loss (via strategy.exit above) is NOT gated by this -- it can still cut a
// losing trade immediately. This only restrains the *discretionary* opposite-signal exit,
// so a trade that just started working isn't closed on early noise before reaching target.
minProfitDistance = atrVal * minProfitForOppExitMult

longUnrealizedMove  = strategy.position_size > 0 ? close - strategy.position_avg_price : 0.0
shortUnrealizedMove = strategy.position_size < 0 ? strategy.position_avg_price - close : 0.0

longOppExitAllowed  = longUnrealizedMove  >= minProfitDistance
shortOppExitAllowed = shortUnrealizedMove >= minProfitDistance

if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=longStopPrice, limit=longTPPrice,
         comment_profit="Take Profit", comment_loss="Stop Loss")
    if longExitSignal and longOppExitAllowed
        strategy.close("Long", comment="Opposite Signal")

if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", stop=shortStopPrice, limit=shortTPPrice,
         comment_profit="Take Profit", comment_loss="Stop Loss")
    if shortExitSignal and shortOppExitAllowed
        strategy.close("Short", comment="Opposite Signal")

// =====================================================================================
// VISUALS - Entry / Exit / SL / TP markers only (clean chart, no channel plotted)
// =====================================================================================

plot(useTrendFilter ? trendEma : na, title="Trend EMA", color=color.new(color.blue, 40), linewidth=2)

// --- Entry markers: small triangles, no on-marker text (text creates clutter at normal zoom) ---
plotshape(showMarkers and longEntrySignal, title="Long Entry", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)

plotshape(showMarkers and shortEntrySignal, title="Short Entry", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)

// --- Exit markers: distinct shape (X) from entries, colored by *why* the trade closed --
// gray = opposite-signal, red = stop-loss hit, green = take-profit hit -- so reviewing the
// chart tells you at a glance whether a loss was "stopped out" or "gave back an opposite signal".
// Read via exit_comment() rather than comparing exit price to stored SL/TP levels, since a
// gap-through-both-levels bar would make price comparison misclassify the exit.
longClosedThisBar  = strategy.position_size <= 0 and strategy.position_size[1] > 0
shortClosedThisBar = strategy.position_size >= 0 and strategy.position_size[1] < 0

lastExitComment = strategy.closedtrades > 0 ? strategy.closedtrades.exit_comment(strategy.closedtrades - 1) : na

exitColorFromComment(cmt) =>
    na(cmt) ? color.gray :
     str.contains(cmt, "Stop Loss") ? color.red :
     str.contains(cmt, "Take Profit") ? color.green :
     color.gray  // "Opposite Signal" and anything else falls here

plotshape(showMarkers and longClosedThisBar, title="Long Position Closed", style=shape.xcross,
     location=location.abovebar, color=color.new(exitColorFromComment(lastExitComment), 20), size=size.tiny)

plotshape(showMarkers and shortClosedThisBar, title="Short Position Closed", style=shape.xcross,
     location=location.belowbar, color=color.new(exitColorFromComment(lastExitComment), 20), size=size.tiny)

// --- SL / TP lines: SL solid red, TP circles green -- distinct line styles so the two are
// never confused at a glance, and only drawn while a position is actually open ---
plot(showMarkers and strategy.position_size > 0 ? longStopPrice : na,
     title="Long Stop Loss", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(showMarkers and strategy.position_size > 0 ? longTPPrice : na,
     title="Long Take Profit", color=color.new(color.green, 0), style=plot.style_circles, linewidth=2)

plot(showMarkers and strategy.position_size < 0 ? shortStopPrice : na,
     title="Short Stop Loss", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(showMarkers and strategy.position_size < 0 ? shortTPPrice : na,
     title="Short Take Profit", color=color.new(color.green, 0), style=plot.style_circles, linewidth=2)

// =====================================================================================
// PERFORMANCE TABLE
// =====================================================================================

if showTable and barstate.islast
    var table perfTable = table.new(position.top_right, 2, 9, border_width=1)

    totalTrades   = strategy.closedtrades
    winTrades     = strategy.wintrades
    lossTrades    = strategy.losstrades
    winRate       = totalTrades > 0 ? (winTrades / totalTrades) * 100 : 0
    netProfit     = strategy.netprofit
    netProfitPct  = (strategy.netprofit / strategy.initial_capital) * 100
    profitFactor  = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    maxDD         = strategy.max_drawdown
    maxDDPct      = (strategy.max_drawdown / strategy.initial_capital) * 100
    avgTrade      = totalTrades > 0 ? strategy.netprofit / totalTrades : 0
    openPos       = strategy.position_size > 0 ? "Long" : strategy.position_size < 0 ? "Short" : "Flat"

    table.cell(perfTable, 0, 0, "Metric", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.small)
    table.cell(perfTable, 1, 0, "Value", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.small)

    table.cell(perfTable, 0, 1, "Net Profit", text_size=size.small)
    table.cell(perfTable, 1, 1, str.tostring(netProfit, "#.##") + " (" + str.tostring(netProfitPct, "#.##") + "%)",
         text_color=netProfit >= 0 ? color.green : color.red, text_size=size.small)

    table.cell(perfTable, 0, 2, "Total Trades", text_size=size.small)
    table.cell(perfTable, 1, 2, str.tostring(totalTrades), text_size=size.small)

    table.cell(perfTable, 0, 3, "Win Rate", text_size=size.small)
    table.cell(perfTable, 1, 3, str.tostring(winRate, "#.##") + "%", text_size=size.small)

    table.cell(perfTable, 0, 4, "Profit Factor", text_size=size.small)
    table.cell(perfTable, 1, 4, na(profitFactor) ? "N/A" : str.tostring(profitFactor, "#.##"), text_size=size.small)

    table.cell(perfTable, 0, 5, "Max Drawdown", text_size=size.small)
    table.cell(perfTable, 1, 5, str.tostring(maxDD, "#.##") + " (" + str.tostring(maxDDPct, "#.##") + "%)",
         text_color=color.red, text_size=size.small)

    table.cell(perfTable, 0, 6, "Avg Trade P&L", text_size=size.small)
    table.cell(perfTable, 1, 6, str.tostring(avgTrade, "#.##"), text_size=size.small)

    table.cell(perfTable, 0, 7, "Current Position", text_size=size.small)
    table.cell(perfTable, 1, 7, openPos,
         text_color=openPos == "Long" ? color.green : openPos == "Short" ? color.red : color.gray, text_size=size.small)

    if useLeverage
        totalBlocked = longBlockedByLiqSafety + shortBlockedByLiqSafety
        table.cell(perfTable, 0, 8, "Blocked (Liq. Risk)", text_size=size.small)
        table.cell(perfTable, 1, 8, str.tostring(totalBlocked),
             text_color=totalBlocked > totalTrades ? color.red : color.gray, text_size=size.small)
